@layout.main({ title : "Dashboard"})
  @slot('main')
    <main class="flex">
      <section class="w-[70%] min-h-screen flex-col items-center justify-between px-6">
        <div class="w-full max-w-5xl bg-white/80 backdrop-blur-md rounded-2xl shadow-lg p-2">

          <!-- Titre -->
          <header class="mb-8">
            <h2 class="text-2xl font-semibold text-gray-800">
              Générer un QR Code
            </h2>
            <p class="text-gray-600 mt-1">
              Entrez un lien, personnalisez votre QR code et générez-le instantanément.
            </p>
          </header>

          <!-- Contenu principal -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Formulaire -->
            <form class="space-y-4">

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="link">
                  Lien
          </label>
                <input
                  type="text"
                  name="link"
                  placeholder="https://exemple.com"
                  class="w-full rounded-lg border-gray-300 focus:border-purple-400 focus:ring-purple-400"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="name">
                  Nom du QR code
          </label>
                <input
                  type="text"
                  name="name"
                  placeholder="Mon QR Code"
                  class="w-full rounded-lg border-gray-300 focus:border-purple-400 focus:ring-purple-400"
                />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="color">
                    Couleur
            </label>
                  <select
                    name="color"
                    class="w-full rounded-lg border-gray-300 focus:border-purple-400 focus:ring-purple-400"
                  >
                    <option>
                      Noir
                    </option>
                    <option>
                      Rouge
                    </option>
                    <option>
                      Vert
                    </option>
                    <option>
                      Bleu
                    </option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="size">
                    Taille
            </label>
                  <select
                    name="size"
                    class="w-full rounded-lg border-gray-300 focus:border-purple-400 focus:ring-purple-400"
                  >
                    <option>
                      Small
                    </option>
                    <option>
                      Medium
                    </option>
                    <option>
                      Large
                    </option>
                  </select>
                </div>
              </div>

              <div class="pt-4">
                <button
                  type="submit"
                  class="bg-purple-500 text-white hover:bg-purple-600 shadow-purple-300 p-2 rounded-xl font-medium shadow-sm transition-all duration-200 w-full mb-2"
                >Generer</button>
              </div>

            </form>

            <!-- Aperçu -->
            <div
              class="flex flex-col items-center justify-center bg-gray-50 rounded-xl p-6 border border-gray-200"
            >

              <p class="text-sm text-gray-600 mb-4">
                Aperçu du QR code
              </p>

              <div class="w-40 h-40 bg-white rounded-lg shadow flex items-center justify-center mb-4">
                <img src="" alt="QR preview" />
              </div>

              <p class="font-medium text-gray-800">
                Nom du QR
              </p>
              <p class="text-sm text-gray-500">
                12 Janvier 2026
              </p>
            </div>
          </div>
        </div>

        <div class="mt-12">

          <!-- Titre -->
          <h3 class="text-lg font-semibold text-gray-800 mb-4">
            10 derniers QR codes générés
          </h3>

          <!-- Liste -->
          <div class="space-y-4">
            <!-- Carte QR -->
            <div
              class="w-[200px] flex-col items-center justify-between bg-white/70 backdrop-blur-md rounded-xl p-2 border border-gray-200 shadow-sm"
            >
              <!-- Infos -->
              <div class=" items-center gap-4">
                <div class="w-40 h-40 bg-white rounded-lg shadow flex items-center justify-center mb-4">
                  <img src="" alt="QR preview" />
                </div>

                <div>
                  <p class="font-medium text-gray-800">
                    Nom du QR
                  </p>
                  <p class="text-sm text-gray-500">
                    Généré le 12 Janvier 2026
                  </p>
                </div>
              </div>

              <!-- Actions -->
              <div class="gap-2">
                <button
                  type="button"
                  class="bg-purple-500 text-white hover:bg-purple-600 shadow-purple-300 p-2 rounded-xl font-medium shadow-sm transition-all duration-200 w-full mb-2"
                >copier</button>

                <button
                  type="button"
                  class="bg-red-500 text-white hover:bg-red-600 shadow-red-300 px-4 py-2 rounded-xl font-medium shadow-sm transition-all duration-200 w-full"
                >supprimer</button>
              </div>

            </div>

            <!-- Fin carte QR -->

          </div>
        </div>

      </section>

      <section
        class="w-[30%] h-screen p-6 flex flex-col justify-between bg-white/50 backdrop-blur-lg border-l border-white/40"
      >

        <!-- HAUT : Stats + Navigation -->
        <div class="space-y-8">
          <!-- STATISTIQUES -->
          <div class="rounded-2xl p-5 bg-gradient-to-tr from-pink-100 via-purple-100 to-blue-100 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
              Statistiques
            </h3>
            <div class="space-y-2 text-gray-700">
              <p class="flex justify-between">
                <span>Total QR générés</span>
                <span class="font-semibold">0</span>
              </p>
              <p class="flex justify-between">
                <span>Aujourd’hui</span>
                <span class="font-semibold">0</span>
              </p>
            </div>
          </div>

          <!-- NAVIGATION -->
          <div class="rounded-2xl p-4 bg-gradient-to-tr from-pink-100 via-purple-100 to-blue-100 shadow-sm">
            <nav class="space-y-3 text-gray-800">

              <p class="font-medium cursor-pointer hover:text-purple-600 transition">
                ➕ Nouveau QR code
              </p>

              <p class="font-medium cursor-pointer hover:text-purple-600 transition">
                📂 Tous les QR codes
              </p>

              <p class="font-medium cursor-pointer hover:text-purple-600 transition">
                ⚙️ Paramètres
              </p>

              <p class="font-medium cursor-pointer hover:text-purple-600 transition">
                🎨 Thème
              </p>

            </nav>
          </div>

        </div>

        <!-- BAS : Profil utilisateur -->
        <div class="rounded-2xl p-4 bg-white/70 shadow-sm">

          <div class="flex items-center gap-3 mb-3">
            <img src="" alt="Avatar" class="w-12 h-12 rounded-full border border-white shadow" />

            <div>
              <p class="font-medium text-gray-800">
                'Nom'
              </p>
              <p class="text-sm text-gray-500">
                Plan : <span class="font-medium">Free</span>
              </p>
            </div>
          </div>

          <form action="/deconnecter">
            <button type="submit" class="text-sm text-red-500 cursor-pointer hover:underline">Deconnexion</button>
          </form>

        </div>

      </section>
    </main>
  @endslot
@end
